[Unit]
Description=VoNet modem and WiFi Calling service
After=network-online.target pcscd.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vonet
Environment=VONET_DATABASE_PATH=/opt/vonet/data/vonet.db
Environment=VONET_ADDR=0.0.0.0:17575
Environment=VONET_AGENT_GRPC_ADDR=0.0.0.0:17577
ExecStart=/opt/vonet/bin/vonet serve
Restart=on-failure
RestartPreventExitStatus=SIGTERM SIGKILL
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
